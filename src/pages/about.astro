---
import "../styles/global.css";
import Particles from "../components/particles.svelte";
import Navbar from "../components/navbar.svelte";
import Footer from "../components/footer.svelte";

const focusAreas = [
  "Everyday IT support",
  "Account and access organization",
  "Device and system documentation",
  "Vendor coordination",
  "Password manager and MFA support",
  "Practical security hygiene",
  "Plain-English support notes",
  "Small-office technology planning",
];

const operatingCards = [
  {
    marker: "01",
    title: "Understand before changing",
    body: "Support starts by mapping the devices, accounts, vendors, workflows, and risks that already exist.",
  },
  {
    marker: "02",
    title: "Document the work",
    body: "Important decisions, systems, access, and follow-up items are written down in plain English.",
  },
  {
    marker: "03",
    title: "Keep ownership clear",
    body: "Client systems stay client-owned. ParkTech uses controlled access where support requires it.",
  },
];

const clientOwnedPoints = [
  "Client-owned billing, domains, accounts, and vendor relationships whenever possible",
  "Named or delegated access instead of shared personal owner logins",
  "Support notes that make systems easier to hand off or offboard",
  "ParkTech access removed cleanly when a relationship ends",
];

const labItems = [
  "Small-office documentation templates",
  "Support intake workflow",
  "Security baseline checklist",
  "Remote support workflow",
  "Website build notes",
  "Future documentation experiments",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>About Park Technologies</title>
    <meta
      name="description"
      content="Learn about Park Technologies, a founder-led IT support business for very small professional offices."
    />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="cyber-grid min-h-screen bg-[#0a0c12]">
    <div class="pointer-events-none absolute inset-0">
      <div
        class="absolute inset-0 bg-gradient-to-b from-[#0a0c12]/0 via-[#0a0c12]/0 to-[#0a0c12]/80"
      >
      </div>
      <div
        id="particles"
        class="pointer-events-none fixed top-0 left-0 z-0 h-screen w-screen"
      >
      </div>
    </div>
    <Particles client:only="svelte" />
    <Navbar />

    <main class="relative z-10">
      <section class="mx-auto max-w-5xl px-4 py-20 text-center sm:py-24">
        <h1
          class="cyber-glitch glow-text text-4xl leading-tight font-semibold text-balance text-[#e0e7ff] sm:text-5xl"
          data-text="Small-office IT, handled plainly."
        >
          Small-office IT, handled plainly.
        </h1>
        <p class="mx-auto max-w-3xl pt-7 text-lg text-[#e0e7ff]">
          Park Technologies helps very small professional offices get practical
          technology support, clearer documentation, and better basic security
          habits without turning the business into an enterprise IT project.
        </p>
      </section>

      <section
        class="mx-auto grid max-w-7xl gap-8 px-4 pb-14 lg:grid-cols-[1.05fr_0.95fr]"
      >
        <div
          class="glow relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27] p-6 sm:p-8"
        >
          <div
            class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#00f0c0] to-[#ff2a6d]"
          >
          </div>
          <p class="text-xs font-bold text-[#ff2a6d]">/&nbsp; Purpose</p>
          <h2 class="pt-3 text-2xl font-semibold text-[#00f0c0]">
            Built for offices that rely on technology but do not have internal
            IT.
          </h2>
          <div class="space-y-4 pt-5 text-[#e0e7ff]">
            <p>
              A small office may only have a few users, but it still depends on
              email, files, devices, printers, vendor portals, backups,
              passwords, and account access working the right way.
            </p>
            <p>
              ParkTech brings structure to that environment by fixing immediate
              issues, documenting what matters, and helping the office make
              better technology decisions over time.
            </p>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 sm:gap-3">
          {
            focusAreas.map((area) => (
              <p class="mobile-solid-surface rounded border border-[#3a3f5e]/80 bg-[#181c27]/80 p-4 text-sm font-semibold text-[#e0e7ff]">
                <span class="text-[#ff2a6d]">/&nbsp;</span>
                {area}
              </p>
            ))
          }
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-4 py-14">
        <div class="section-tag mb-6">
          <span class="section-tag__marker">&gt;</span>
          <span class="section-tag__text">How ParkTech works</span>
        </div>

        <div class="grid gap-5 md:grid-cols-3">
          {
            operatingCards.map((card) => (
              <article class="mobile-solid-surface relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27]/90 p-6">
                <div class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#00f0c0] to-[#ff2a6d]" />
                <p class="gradient-text text-xs font-bold">{card.marker}</p>
                <h3 class="pt-4 text-xl font-semibold text-[#e0e7ff]">
                  {card.title}
                </h3>
                <p class="pt-4 text-sm text-[#a0aed0]">{card.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="mx-auto grid max-w-7xl gap-8 px-4 py-14 lg:grid-cols-[0.9fr_1.1fr]"
      >
        <div
          class="glow-alt relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27] p-6 sm:p-8"
        >
          <div
            class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#ff2a6d] to-[#00f0c0]"
          >
          </div>
          <p class="text-xs font-bold text-[#00f0c0]">
            /&nbsp; Operating principle
          </p>
          <h2 class="pt-3 text-2xl font-semibold text-[#ff2a6d]">
            Your business systems should stay under your control.
          </h2>
          <p class="pt-5 text-[#e0e7ff]">
            ParkTech's operating principle is simple: the client owns the
            systems. ParkTech gets controlled access. ParkTech documents the
            work. ParkTech removes access when the relationship ends.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 sm:gap-3">
          {
            clientOwnedPoints.map((point) => (
              <p class="mobile-solid-surface rounded border border-[#3a3f5e]/80 bg-[#181c27]/80 p-4 text-sm font-semibold text-[#e0e7ff]">
                <span class="text-[#00f0c0]">/&nbsp;</span>
                {point}
              </p>
            ))
          }
        </div>
      </section>

      <section class="mx-auto grid max-w-7xl gap-8 px-4 py-14 lg:grid-cols-2">
        <div
          class="glow relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27] p-6 sm:p-8"
        >
          <div
            class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#00f0c0] to-[#ff2a6d]"
          >
          </div>
          <p class="text-xs font-bold text-[#ff2a6d]">/&nbsp; Founder-led</p>
          <h2 class="pt-3 text-2xl font-semibold text-[#00f0c0]">
            Direct help from Jessie.
          </h2>
          <p class="pt-5 text-[#e0e7ff]">
            Park Technologies is founder-led, so clients work directly with the
            person responsible for the support, documentation, and
            follow-through.
          </p>
          <p class="pt-4 text-[#a0aed0]">
            Jessie's background in technical support and systems administration
            shapes the approach: listen first, document carefully, explain
            plainly, and avoid unnecessary complexity.
          </p>
        </div>

        <div
          class="glow-alt relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27] p-6 sm:p-8"
        >
          <div
            class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#ff2a6d] to-[#00f0c0]"
          >
          </div>
          <p class="text-xs font-bold text-[#00f0c0]">/&nbsp; Founder's Lab</p>
          <h2 class="pt-3 text-2xl font-semibold text-[#ff2a6d]">
            Internal work that supports the business.
          </h2>
          <p class="pt-5 text-[#e0e7ff]">
            The Founder's Lab is where ParkTech keeps build notes, templates,
            and technical experiments that improve the way support is delivered.
            It is credibility for the work, not the main offer.
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-3">
            {
              labItems.map((item) => (
                <p class="mobile-solid-surface-dark rounded border border-[#3a3f5e]/80 bg-[#0a0c12]/60 p-3 text-sm font-semibold text-[#e0e7ff]">
                  <span class="text-[#ff2a6d]">/&nbsp;</span>
                  {item}
                </p>
              ))
            }
          </div>
          <p class="pt-5 text-sm font-semibold text-[#a0aed0]">
            ParkTech does not publish client data, credentials, sensitive
            screenshots, internal access registers, or fake case studies.
          </p>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-4 py-20">
        <div
          class="relative overflow-hidden rounded-lg border border-[#3a3f5e] bg-[#181c27]/95 p-6 shadow-lg sm:p-8"
        >
          <div
            class="absolute top-0 left-0 h-1 w-full bg-gradient-to-r from-[#00f0c0] to-[#ff2a6d]"
          >
          </div>
          <div
            class="absolute right-0 bottom-0 h-20 w-20 border-r border-b border-[#00f0c0]/30"
          >
          </div>
          <div
            class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between"
          >
            <div class="max-w-3xl">
              <p class="text-xs font-bold text-[#ff2a6d]">/&nbsp; Next step</p>
              <h2 class="pt-3 text-2xl font-bold text-[#e0e7ff]">
                Technology support should make the office clearer.
              </h2>
              <p class="pt-2 font-semibold text-[#a0aed0]">
                ParkTech is built for small offices that need technology
                organized, documented, and easier to support.
              </p>
            </div>
            <a
              class="glow inline-flex w-full items-center justify-center rounded bg-[#00f0c0] px-7 py-3 text-center text-sm font-bold text-[#0a0c12] transition-all duration-300 hover:-translate-y-1 hover:bg-[#00f0c0]/90 sm:w-auto"
              href="/contact/"
            >
              Contact ParkTech
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
